{
  "name": "canvas-lms",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "web",
  "workspaceFolder": "/usr/src/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "koichisasada.vscode-rdbg",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Shopify.ruby-lsp",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "cp config/docker-compose.override.yml.example docker-compose.override.yml && touch .env && cp docker-compose/config/*.yml config/"
}